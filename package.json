{
  "name": "where-am-i",
  "version": "0.1.0",
  "description": "Visualize how code changes affect APIs, services, databases, and tests across repositories.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soil0119/Where-am-i.git"
  },
  "bugs": {
    "url": "https://github.com/soil0119/Where-am-i/issues"
  },
  "homepage": "https://github.com/soil0119/Where-am-i#readme",
  "keywords": [
    "code-visualization",
    "dependency-graph",
    "impact-analysis",
    "developer-tools",
    "multi-repo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "scan": "node scripts/scan-repos.mjs",
    "scan:watch": "node scripts/scan-repos.mjs --watch",
    "scan:server": "node scripts/scan-server.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.27.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.9",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}
